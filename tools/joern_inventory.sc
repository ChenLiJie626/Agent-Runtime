// SPEC 005 PoC-only fixed queries. This script is not exposed to Agents.
@main def exec(cpgFile: String) = {
  importCpg(cpgFile)
  println("SPEC005_METHODS_BEGIN")
  println(cpg.method.name("getBuffer|process|guardedProcess|indirectEntry|main").toJsonPretty)
  println("SPEC005_METHODS_END")
  println("SPEC005_CALLS_BEGIN")
  println(cpg.call.code(".*getBuffer.*|.*process.*|.*callback.*").toJsonPretty)
  println("SPEC005_CALLS_END")
  println("SPEC005_NULL_LITERALS_BEGIN")
  println(cpg.literal.code("nullptr").toJsonPretty)
  println("SPEC005_NULL_LITERALS_END")
  println("SPEC005_GUARDS_BEGIN")
  println(cpg.method.name("guardedProcess").controlStructure.toJsonPretty)
  println("SPEC005_GUARDS_END")
  println("SPEC005_DIRECT_CALLS_INTO_GETBUFFER_BEGIN")
  println(cpg.method.name("getBuffer").callIn.toJsonPretty)
  println("SPEC005_DIRECT_CALLS_INTO_GETBUFFER_END")
  println("SPEC005_PROCESS_CALLERS_BEGIN")
  println(cpg.method.name("process").callIn.toJsonPretty)
  println("SPEC005_PROCESS_CALLERS_END")
  println("SPEC005_GETBUFFER_PARAMETERS_BEGIN")
  println(cpg.method.name("getBuffer").parameter.toJsonPretty)
  println("SPEC005_GETBUFFER_PARAMETERS_END")
  println("SPEC005_GETBUFFER_ARGUMENTS_BEGIN")
  println(cpg.call.name("getBuffer").argument.toJsonPretty)
  println("SPEC005_GETBUFFER_ARGUMENTS_END")
  println("SPEC005_DEREFERENCES_BEGIN")
  println(cpg.call.name("<operator>.indirection").toJsonPretty)
  println("SPEC005_DEREFERENCES_END")
  println("SPEC005_NULL_TO_DEREFERENCE_FLOWS_BEGIN")
  println(cpg.call.name("<operator>.indirection").reachableByFlows(cpg.literal.code("nullptr")).p)
  println("SPEC005_NULL_TO_DEREFERENCE_FLOWS_END")
  println("SPEC005_CALL_TO_DEREFERENCE_FLOWS_BEGIN")
  println(cpg.call.name("<operator>.indirection").reachableByFlows(cpg.call.name("getBuffer")).p)
  println("SPEC005_CALL_TO_DEREFERENCE_FLOWS_END")
  println("SPEC005_CALL_TO_DEREFERENCE_ARGUMENT_FLOWS_BEGIN")
  println(cpg.call.name("<operator>.indirection").argument.reachableByFlows(cpg.call.name("getBuffer")).p)
  println("SPEC005_CALL_TO_DEREFERENCE_ARGUMENT_FLOWS_END")
  println("SPEC005_MAIN_ZERO_TO_GETBUFFER_ARGUMENT_FLOWS_BEGIN")
  println(cpg.call.name("getBuffer").argument.reachableByFlows(cpg.method.name("main").ast.isLiteral.code("0")).p)
  println("SPEC005_MAIN_ZERO_TO_GETBUFFER_ARGUMENT_FLOWS_END")
  println("SPEC005_GUARDED_DEREFERENCE_DOMINATORS_BEGIN")
  println(cpg.method.name("guardedProcess").ast.isCall.name("<operator>.indirection").dominatedBy.code.l)
  println("SPEC005_GUARDED_DEREFERENCE_DOMINATORS_END")
  println("SPEC005_GUARD_TRUE_BRANCH_AST_BEGIN")
  println(cpg.method.name("guardedProcess").controlStructure.whenTrue.ast.code.l)
  println("SPEC005_GUARD_TRUE_BRANCH_AST_END")
  println("SPEC005_GUARDED_DEREFERENCE_CONTROLLED_BY_BEGIN")
  println(cpg.method.name("guardedProcess").ast.isCall.name("<operator>.indirection").controlledBy.code.l)
  println("SPEC005_GUARDED_DEREFERENCE_CONTROLLED_BY_END")
}
